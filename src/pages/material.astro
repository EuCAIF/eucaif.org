---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getCollection, getEntry, render } from 'astro:content';

const items = (await getCollection('materials')).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const policy = (await getEntry('sections', 'material-policy'))!;
const { Content: PolicyContent } = await render(policy);

// Live site lists items chronologically with DD/MM/YYYY dates.
function formatDate(d: Date) {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${p(d.getUTCDate())}/${p(d.getUTCMonth() + 1)}/${d.getUTCFullYear()}`;
}
---

<Layout title="Material – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">Material</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container">
    <h2 class="section-title">Selected reports, position papers, and presentations</h2>
    <div class="pub-list">
      {items.map(item => (
        <div class="pub-item">
          <span class="pub-tag">{formatDate(item.data.date)}</span>
          <div class="pub-content">
            <h4>{item.data.title}</h4>
          </div>
          <div class="pub-links">
            {item.data.links.map(l => <a class="pub-link" href={l.url} target="_blank" rel="noopener">{l.label} →</a>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="prose-section" id="policy">
  <div class="section-container prose">
    <h2 class="section-title">{policy.data.title}</h2>
    <PolicyContent />
  </div>
</section>

<Footer />
</Layout>
