---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import yaml from 'js-yaml';
import matRaw from '../data/materials.yml?raw';

type Item = { date: string; title: string; type: string; venue?: string; links: { label: string; url: string }[] };
const items = (yaml.load(matRaw) as Item[]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(date: string) {
  const d = new Date(date);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
}
---

<Layout title="Material – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <div class="section-label">Material</div>
    <h1 class="section-title">Reports, position papers and presentations</h1>
    <p class="section-desc">
      Documents produced by EuCAIF and its partners that set out the coalition's strategy for AI in fundamental physics.
    </p>
  </div>
</section>

<section class="material-section">
  <div class="section-container">
    <div class="pub-list">
      {items.map(item => (
        <div class="pub-item">
          <span class="pub-tag">{item.type}</span>
          <div class="pub-content">
            <h4>{item.title}</h4>
            <p>{formatDate(item.date)}{item.venue && ` · ${item.venue}`}</p>
          </div>
          <div class="pub-links">
            {item.links.map(l => <a class="pub-link" href={l.url} target="_blank" rel="noopener">{l.label} →</a>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="prose-section" id="policy">
  <div class="section-container prose">
    <div class="section-label">Guidelines and procedures</div>
    <h2 class="section-title">EuCAIF policy document</h2>
    <p>
      The EuCAIF policy document is endorsed by the EuCAIF fellows and describes the goals and the procedures of
      EuCAIF: membership levels, the fellowship application process, the role of the management board, and how
      decisions are taken.
    </p>
    <p>
      <a class="btn-primary" href="/eucaif.org/documents/EuCAIF-policy-v0.7.pdf">Download the policy document (PDF, v0.7)</a>
    </p>
  </div>
</section>

<Footer />
</Layout>
