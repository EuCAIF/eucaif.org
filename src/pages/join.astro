---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EditLink from '../components/EditLink.astro';
import '../styles/global.css';
import { getCollection, getEntry, render } from 'astro:content';

const intro = (await getEntry('sections', 'join-intro'))!;
const requirements = (await getEntry('sections', 'join-requirements'))!;
const { Content: IntroContent } = await render(intro);
const { Content: RequirementsContent } = await render(requirements);

const levels = (await getCollection('membership')).sort((a, b) => a.data.order - b.data.order);
const levelBlocks = await Promise.all(levels.map(async l => ({ ...l, Content: (await render(l)).Content })));
---

<Layout title="How to join – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">How to join</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container">
    <div class="prose">
      <h2 class="section-title">{intro.data.title}</h2>
      <IntroContent />
    </div>

    <ol class="levels">
      {levelBlocks.map((l, i) => (
        <li class={`level ${l.data.highlight ? 'level-highlight' : ''}`}>
          <div class="level-marker"><span>{i + 1}</span></div>
          <div class="level-body prose">
            <h3>{l.data.title}</h3>
            <l.Content />
            {l.data.highlight && <RequirementsContent />}
          </div>
        </li>
      ))}
    </ol>
    <EditLink path="src/content/membership" label="Edit this page on GitHub" folder />
  </div>
</section>

<Footer />
</Layout>
