---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EditLink from '../components/EditLink.astro';
import '../styles/global.css';
import { getEntry, render } from 'astro:content';

const contact = (await getEntry('sections', 'contact'))!;
const { Content } = await render(contact);
---

<Layout title="Contact – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">Contact</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container prose">
    <h2 class="section-title">{contact.data.title}</h2>
    <Content />
    <EditLink path="src/content/sections/contact.md" />
  </div>
</section>

<Footer />
</Layout>
