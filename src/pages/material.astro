---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import yaml from 'js-yaml';
import matRaw from '../data/materials.yml?raw';

type Item = { date: string; title: string; links: { label: string; url: string }[] };
const items = yaml.load(matRaw) as Item[];

// Live site lists items chronologically with DD/MM/YYYY dates.
function formatDate(date: string) {
  const d = new Date(date);
  const p = (n: number) => String(n).padStart(2, '0');
  return `${p(d.getUTCDate())}/${p(d.getUTCMonth() + 1)}/${d.getUTCFullYear()}`;
}
---

<Layout title="Material – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">Material</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container">
    <h2 class="section-title">Selected reports, position papers, and presentations</h2>
    <div class="pub-list">
      {items.map(item => (
        <div class="pub-item">
          <span class="pub-tag">{formatDate(item.date)}</span>
          <div class="pub-content">
            <h4>{item.title}</h4>
          </div>
          <div class="pub-links">
            {item.links.map(l => <a class="pub-link" href={l.url} target="_blank" rel="noopener">{l.label} →</a>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="prose-section" id="policy">
  <div class="section-container prose">
    <h2 class="section-title">EuCAIF guidelines and procedures</h2>
    <p>
      The EuCAIF policy document is endorsed by the EuCAIF fellows and describes the goals and the procedures of EuCAIF
      (<a href="/eucaif.org/documents/EuCAIF-policy-v0.7.pdf">pdf</a>).
    </p>
  </div>
</section>

<Footer />
</Layout>
