---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Text verbatim from https://eucaif.org/contact/
---

<Layout title="Contact – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">Contact</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container prose">
    <h2 class="section-title">How to stay in touch</h2>
    <p>If you like to follow the activities of EuCAIF please join the following e-group: <a href="mailto:eucaif-info@cern.ch">eucaif-info@cern.ch</a></p>
    <p>How? If you would like to apply for membership of a CERN e-group, visit <a href="http://cern.ch/egroups">http://cern.ch/egroups</a> and search for the e-group (e.g. eucaif-info) you would like to join.</p>
    <p>To reach out to the management board, please write to <a href="mailto:info@eucaif.org">info@eucaif.org</a></p>
  </div>
</section>

<Footer />
</Layout>
