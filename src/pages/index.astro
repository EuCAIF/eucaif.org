---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import yaml from 'js-yaml';
import { getCollection, getEntry, render } from 'astro:content';
import membersRaw from '../data/members.yml?raw';
import pubsRaw from '../data/publications.yml?raw';
import EuropeMap from '../components/EuropeMap.astro';
import { url, site } from '../lib/site';

const { upcoming, latest } = site.conference;
const confLink = upcoming?.url || latest.url || url('/#conference');

const members = yaml.load(membersRaw) as { given_name: string; surname: string; affiliation: string; country: string; roles: string[] }[];
const allPublications = yaml.load(pubsRaw) as { title: string; authors: string[]; eucaif_authors: string[]; arxiv: string | null; date: string | null; abstract: string }[];
// Landing page: four recent fellow-led papers (large-collaboration papers excluded).
const MAX_AUTHORS = 50;
const publications = allPublications.filter(p => p.authors.length <= MAX_AUTHORS).slice(0, 4);

function formatAuthors(authors: string[]) {
  if (authors.length <= 3) return authors.join(', ');
  return `${authors[0]} et al.`;
}

function formatDate(date: string | null) {
  if (!date) return '';
  const d = new Date(date);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[d.getMonth()]} ${d.getFullYear()}`;
}
const fellowCount = members.filter(m => m.roles.includes('fellow')).length;
const juniorCount = members.filter(m => m.roles.includes('junior-fellow')).length;
const countries = [...new Set(members.map(m => m.country))];
const countryCount = countries.length;

// Prose sections and research domains live in src/content/ as Markdown.
const tagline = (await getEntry('sections', 'tagline'))!;
const purpose = (await getEntry('sections', 'purpose'))!;
const conference = (await getEntry('sections', 'conference'))!;
const about = (await getEntry('sections', 'about'))!;
const { Content: PurposeContent } = await render(purpose);
const { Content: ConferenceContent } = await render(conference);
const { Content: AboutContent } = await render(about);

const domains = (await getCollection('researchDomains')).sort((a, b) => a.data.order - b.data.order);
const domainBlocks = await Promise.all(domains.map(async d => ({ ...d, Content: (await render(d)).Content })));
---

<Layout title="EuCAIF – European Coalition for AI in Fundamental Physics">
<Nav />

<!-- HERO -->
<section class="hero hero-light">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <h1><b>Eu</b>ropean <b>C</b>oalition for <b>AI</b> in <b>F</b>undamental Physics</h1>
    {upcoming ? (
      <a class="hero-conf" href={upcoming.url || '#conference'}>
        <span class="hero-conf-label">Upcoming</span>
        <span class="hero-conf-title">{upcoming.name}, {upcoming.venue}</span>
        <span class="hero-conf-meta">{upcoming.dates}</span>
      </a>
    ) : (
      <a class="hero-conf" href={latest.url || '#conference'}>
        <span class="hero-conf-label">Most recent conference</span>
        <span class="hero-conf-title">{latest.name}, {latest.venue}</span>
        <span class="hero-conf-meta">{latest.dates}</span>
      </a>
    )}
  </div>
</section>

<!-- SUBFIELDS -->
<section id="subfields">
  <div class="section-container">
    <h2 class="section-title centered reveal">{tagline.data.title}</h2>
    <div class="subfields-grid reveal reveal-delay-2">
      {domainBlocks.map(d => (
        <div class="subfield-card">
          <img class="subfield-thumb" src={url(d.data.image)} alt="" loading="lazy" />
          <div class="subfield-body">
            <h3>{d.data.title}</h3>
            <div class="subfield-text"><d.Content /></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PURPOSE AND SCOPE -->
<section id="about" class="about-section">
  <div class="section-container">
    <h2 class="section-title centered reveal">{purpose.data.title}</h2>
    <div class="about-text purpose-text reveal reveal-delay-2">
      <PurposeContent />
    </div>
  </div>
</section>

<!-- CONFERENCE -->
<section id="conference" class="conference-section">
  <div class="section-container">
    <div class="reveal">
      <h2 class="section-title centered">{conference.data.title}</h2>
      <p class="section-subtitle centered">{conference.data.subtitle}</p>
    </div>
    <div class="conf-grid reveal reveal-delay-2">
      <div class="conf-info">
        <ConferenceContent />
        <p>{latest.name} took place in {latest.venue}, {latest.dates}.</p>
        {upcoming && <p class="conf-next"><strong>{upcoming.name} will take place in {upcoming.venue}, {upcoming.dates.toLowerCase()}.</strong>{!upcoming.url && ' Exact dates will be announced here.'}</p>}
        <div class="conf-actions">
          <a href={confLink} class="btn-primary" target={confLink.startsWith('http') ? '_blank' : undefined} rel="noopener">More information</a>
        </div>
      </div>
      <img class="conf-photo" src={url('/images/conference.jpg')} alt="Audience at EuCAIFCon" loading="lazy" />
    </div>
  </div>
</section>

<!-- ABOUT EUCAIF -->
<section id="about-eucaif" class="about-eucaif-section">
  <div class="section-container">
    <h2 class="section-title centered reveal">{about.data.title}</h2>
    <div class="about-eucaif-grid">
      <div class="about-visual reveal">
        <EuropeMap highlightedCountries={countries} />
        <p class="map-caption">{fellowCount} fellows and {juniorCount} junior fellows at institutions in {countryCount} countries</p>
      </div>
      <div class="about-eucaif-text reveal reveal-delay-2">
        <AboutContent />
        <div class="partner-logos">
          <a href="https://nupecc.org/jenaa/" target="_blank" rel="noopener"><img src={url('/images/jenaa.png')} alt="JENAA – Joint ECFA-NuPECC-APPEC Activities" loading="lazy" /></a>
          <a href="https://ecfa.web.cern.ch/" target="_blank" rel="noopener"><img src={url('/images/ecfa.jpg')} alt="ECFA – European Committee for Future Accelerators" loading="lazy" /></a>
          <a href="https://www.nupecc.net/" target="_blank" rel="noopener"><img src={url('/images/nupecc.png')} alt="NuPECC – Nuclear Physics European Collaboration Committee" loading="lazy" /></a>
          <a href="https://www.appec.org/" target="_blank" rel="noopener"><img src={url('/images/appec.png')} alt="APPEC – Astroparticle Physics European Consortium" loading="lazy" /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LATEST PREPRINTS (generated from INSPIRE) -->
<section id="papers" class="publications-section">
  <div class="section-container">
    <div class="reveal">
      <h2 class="section-title">Recent publications</h2>
      <p class="section-desc">
        {publications.length} of {allPublications.length} AI-related papers by EuCAIF fellows in the last twelve months, automatically collected from INSPIRE HEP.
      </p>
    </div>
    <div class="pub-list">
      {publications.map((pub, i) => (
        <div class={`pub-item reveal ${i < 4 ? `reveal-delay-${i + 1}` : ''}`}>
          <span class="pub-tag">{formatDate(pub.date)}</span>
          <div class="pub-content">
            <h4>{pub.title}</h4>
            <p>{formatAuthors(pub.authors)}</p>
          </div>
          {pub.arxiv && <a class="pub-link" href={`https://arxiv.org/abs/${pub.arxiv}`}>arXiv →</a>}
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top: 2.5rem;" class="reveal">
      <a href={url('/publications/')} class="btn-secondary">All publications →</a>
    </div>
  </div>
</section>

<Footer />

<script>
// HERO: seven domains, one representation.
// Points in the seven research-theme colours drift between their own clusters
// and shared, mixed clusters. Static under prefers-reduced-motion; paused offscreen.
(() => {
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const css = getComputedStyle(document.documentElement);
  const THEMES = ['theoretical', 'particle', 'nuclear', 'astroparticle', 'gravitational', 'cosmology', 'accelerator'];
  const colours = THEMES.map(t => css.getPropertyValue(`--theme-${t}`).trim() || '#999');
  const lineColour = css.getPropertyValue('--slate').trim() || '#73848b';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const PER_THEME = 26, MIXED = 3;
  type P = { x: number; y: number; vx: number; vy: number; theme: number; mixed: number; jx: number; jy: number };
  let pts: P[] = [], W = 0, H = 0, dpr = 1;

  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  function layout() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  // Domain centres on a gentle arc across the left two thirds; mixed centres in the same region.
  function domainCentre(i: number, narrow: boolean) {
    const n = THEMES.length, f = i / (n - 1);
    const x = narrow ? W * (0.1 + 0.8 * f) : W * (0.05 + 0.33 * f);
    const y = narrow ? H * (0.78 + 0.1 * Math.sin(f * Math.PI)) : H * (0.55 - 0.32 * Math.sin(f * Math.PI));
    return { x, y };
  }
  function mixedCentre(k: number, narrow: boolean) {
    return narrow
      ? { x: W * (0.2 + 0.3 * k), y: H * 0.82 }
      : { x: W * (0.1 + 0.14 * k), y: H * (0.38 + 0.26 * ((k + 1) % 2)) };
  }
  function init() {
    layout();
    pts = [];
    for (let t = 0; t < THEMES.length; t++) for (let i = 0; i < PER_THEME; i++) {
      const c = domainCentre(t, W < 860);
      const ang = rand(0, Math.PI * 2), r = Math.sqrt(Math.random());   // uniform in a disc
      pts.push({ x: c.x + rand(-40, 40), y: c.y + rand(-40, 40), vx: 0, vy: 0, theme: t,
        mixed: Math.floor(Math.random() * MIXED), jx: r * Math.cos(ang), jy: r * Math.sin(ang) });
    }
  }
  const smooth = (u: number) => u * u * (3 - 2 * u);
  // Cycle: hold apart 5s, merge 4s, hold mixed 7s, separate 4s.
  const CYCLE = 20;
  function blend(time: number) {
    const u = time % CYCLE;
    if (u < 5) return 0;
    if (u < 9) return smooth((u - 5) / 4);
    if (u < 16) return 1;
    return 1 - smooth((u - 16) / 4);
  }
  let lastB = 0;
  function step(time: number) {
    const narrow = W < 860;
    const b = blend(time);
    if (lastB === 0 && b > 0) pts.forEach(p => { p.mixed = Math.floor(Math.random() * MIXED); });
    lastB = b;
    const spread = narrow ? 26 : 44;
    for (const p of pts) {
      const d = domainCentre(p.theme, narrow), m = mixedCentre(p.mixed, narrow);
      const tx = d.x + (m.x - d.x) * b + p.jx * spread * (1 + 0.6 * b);
      const ty = d.y + (m.y - d.y) * b + p.jy * spread * (1 + 0.6 * b);
      p.vx += (tx - p.x) * 0.012 + (Math.random() - 0.5) * 0.25;
      p.vy += (ty - p.y) * 0.012 + (Math.random() - 0.5) * 0.25;
      p.vx *= 0.9; p.vy *= 0.9;
      p.x += p.vx; p.y += p.vy;
    }
  }
  function draw() {
    ctx.clearRect(0, 0, W, H);
    const LINK = 46;
    ctx.lineWidth = 1;
    for (let i = 0; i < pts.length; i++) for (let j = i + 1; j < pts.length; j++) {
      const a = pts[i], c = pts[j];
      const dx = a.x - c.x, dy = a.y - c.y;
      if (Math.abs(dx) > LINK || Math.abs(dy) > LINK) continue;
      const dist = Math.hypot(dx, dy);
      if (dist > LINK) continue;
      ctx.strokeStyle = lineColour;
      ctx.globalAlpha = (1 - dist / LINK) * (a.theme === c.theme ? 0.08 : 0.16);
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(c.x, c.y); ctx.stroke();
    }
    ctx.globalAlpha = 0.9;
    for (const p of pts) {
      ctx.fillStyle = colours[p.theme];
      ctx.beginPath(); ctx.arc(p.x, p.y, 3, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  init();
  window.addEventListener('resize', init);
  if (reduced) {
    // Settle into the mixed state and draw once.
    for (let i = 0; i < 400; i++) step(12);
    draw();
    return;
  }
  let running = true, start = performance.now();
  new IntersectionObserver(([e]) => { running = e.isIntersecting; if (running) requestAnimationFrame(frame); }, { threshold: 0.05 }).observe(canvas);
  function frame(now: number) {
    if (!running) return;
    step((now - start) / 1000);
    draw();
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();

// SCROLL REVEAL
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

</script>

</Layout>
