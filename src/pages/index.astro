---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import yaml from 'js-yaml';
import { getCollection, getEntry, render } from 'astro:content';
import membersRaw from '../data/members.yml?raw';
import pubsRaw from '../data/publications.yml?raw';
import EuropeMap from '../components/EuropeMap.astro';

const members = yaml.load(membersRaw) as { given_name: string; surname: string; affiliation: string; country: string; roles: string[] }[];
const allPublications = yaml.load(pubsRaw) as { title: string; authors: string[]; eucaif_authors: string[]; arxiv: string | null; date: string | null; abstract: string }[];
const publications = allPublications.slice(0, 8);

function formatAuthors(authors: string[]) {
  if (authors.length <= 3) return authors.join(', ');
  return `${authors[0]} et al.`;
}

function formatDate(date: string | null) {
  if (!date) return '';
  const d = new Date(date);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[d.getMonth()]} ${d.getFullYear()}`;
}
const fellowCount = members.filter(m => m.roles.includes('fellow')).length;
const juniorCount = members.filter(m => m.roles.includes('junior-fellow')).length;
const countries = [...new Set(members.map(m => m.country))];
const countryCount = countries.length;

// Prose sections and research domains live in src/content/ as Markdown.
const tagline = (await getEntry('sections', 'tagline'))!;
const purpose = (await getEntry('sections', 'purpose'))!;
const conference = (await getEntry('sections', 'conference'))!;
const about = (await getEntry('sections', 'about'))!;
const { Content: PurposeContent } = await render(purpose);
const { Content: ConferenceContent } = await render(conference);
const { Content: AboutContent } = await render(about);

const domains = (await getCollection('researchDomains')).sort((a, b) => a.data.order - b.data.order);
const domainBlocks = await Promise.all(domains.map(async d => ({ ...d, Content: (await render(d)).Content })));
---

<Layout title="EuCAIF – European Coalition for AI in Fundamental Physics">
<Nav />

<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <h1>European Coalition for AI in Fundamental Physics</h1>
    <a class="hero-upcoming" href="https://indico.physi.uni-heidelberg.de/event/1277/" target="_blank" rel="noopener">
      <span class="hero-upcoming-label"><span class="pulse"></span> Upcoming</span>
      <span class="hero-upcoming-title">EuCAIFCon 2026</span>
      <span class="hero-upcoming-meta">August 24 - 28, Heidelberg</span>
    </a>
  </div>
</section>
<div class="stats-bar">
  <div class="stat">
    <div class="stat-number" data-target={fellowCount}>0</div>
    <div class="stat-label">Fellows</div>
  </div>
  <div class="stat">
    <div class="stat-number" data-target={juniorCount}>0</div>
    <div class="stat-label">Junior Fellows</div>
  </div>
  <div class="stat">
    <div class="stat-number" data-target={countryCount}>0</div>
    <div class="stat-label">Countries</div>
  </div>
</div>

<!-- SUBFIELDS -->
<section id="subfields">
  <div class="section-container">
    <h2 class="section-title centered reveal">{tagline.data.title}</h2>
    <div class="subfields-grid reveal reveal-delay-2">
      {domainBlocks.map(d => (
        <div class="subfield-card">
          <img class="subfield-thumb" src={d.data.image} alt="" loading="lazy" />
          <h3>{d.data.title}</h3>
          <div class="subfield-text"><d.Content /></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PURPOSE AND SCOPE -->
<section id="about" class="about-section">
  <div class="section-container">
    <h2 class="section-title centered reveal">{purpose.data.title}</h2>
    <div class="about-text purpose-text reveal reveal-delay-2">
      <PurposeContent />
    </div>
  </div>
</section>

<!-- CONFERENCE -->
<section id="conference" class="conference-section">
  <div class="section-container">
    <div class="reveal">
      <h2 class="section-title centered">{conference.data.title}</h2>
      <p class="section-subtitle centered">{conference.data.subtitle}</p>
    </div>
    <div class="conf-grid reveal reveal-delay-2">
      <div class="conf-info">
        <ConferenceContent />
        <div class="conf-actions">
          <a href="https://indico.physi.uni-heidelberg.de/event/1277/" class="btn-primary" target="_blank" rel="noopener">More information</a>
        </div>
      </div>
      <img class="conf-photo" src="/eucaif.org/images/conference.jpg" alt="Audience at EuCAIFCon" loading="lazy" />
    </div>
  </div>
</section>

<!-- ABOUT EUCAIF -->
<section id="about-eucaif" class="about-eucaif-section">
  <div class="section-container">
    <h2 class="section-title centered reveal">{about.data.title}</h2>
    <div class="about-eucaif-grid">
      <div class="about-visual reveal">
        <EuropeMap highlightedCountries={countries} />
      </div>
      <div class="about-eucaif-text reveal reveal-delay-2">
        <AboutContent />
        <img class="jenaa-logo" src="/eucaif.org/images/jenaa.png" alt="JENAA – Joint ECFA-NuPECC-APPEC Activities" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- LATEST PREPRINTS (generated from INSPIRE) -->
<section id="papers" class="publications-section">
  <div class="section-container">
    <div class="reveal">
      <h2 class="section-title">Latest Papers</h2>
      <p class="section-desc">
        Recent AI-related papers from EuCAIF fellows, automatically collected from INSPIRE HEP.
      </p>
    </div>
    <div class="pub-list">
      {publications.map((pub, i) => (
        <div class={`pub-item reveal ${i < 4 ? `reveal-delay-${i + 1}` : ''}`}>
          <span class="pub-tag">{formatDate(pub.date)}</span>
          <div class="pub-content">
            <h4>{pub.title}</h4>
            <p>{formatAuthors(pub.authors)}</p>
          </div>
          {pub.arxiv && <a class="pub-link" href={`https://arxiv.org/abs/${pub.arxiv}`}>arXiv →</a>}
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top: 2.5rem;" class="reveal">
      <a href="/eucaif.org/publications/" class="btn-secondary">More papers →</a>
    </div>
  </div>
</section>

<Footer />

<script>
// SCROLL REVEAL
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// COUNTER ANIMATION
function animateCounters() {
  document.querySelectorAll('.stat-number').forEach(el => {
    const target = parseInt((el as HTMLElement).dataset.target!);
    const suffix = (el as HTMLElement).dataset.suffix || '';
    const duration = 2000;
    const start = performance.now();
    function update(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(target * eased) + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  });
}

const statsObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      animateCounters();
      statsObserver.disconnect();
    }
  });
}, { threshold: 0.5 });
const statsBar = document.querySelector('.stats-bar');
if (statsBar) statsObserver.observe(statsBar);
</script>

</Layout>
