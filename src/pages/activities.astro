---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getCollection, getEntry, render } from 'astro:content';

const intro = (await getEntry('sections', 'activities-intro'))!;
const signup = (await getEntry('sections', 'activities-signup'))!;
const conference = (await getEntry('sections', 'conference'))!;
const { Content: IntroContent } = await render(intro);
const { Content: SignupContent } = await render(signup);
const { Content: ConferenceContent } = await render(conference);

const groups = (await getCollection('workingGroups')).sort((a, b) => a.data.order - b.data.order);
const groupBlocks = await Promise.all(groups.map(async g => ({ ...g, Content: (await render(g)).Content })));
---

<Layout title="Activities – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">Activities</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container">
    <h2 class="section-title">{intro.data.title}</h2>
    <div class="section-desc"><IntroContent /></div>
    <div class="wg-list">
      {groupBlocks.map(wg => (
        <article class="wg-card" id={wg.data.code.toLowerCase()}>
          <span class="wg-code">{wg.data.code}</span>
          <h3>{wg.data.title}</h3>
          <div class="wg-text"><wg.Content /></div>
          {wg.data.image && <img class="wg-image" src={wg.data.image} alt="" loading="lazy" />}
        </article>
      ))}
    </div>
  </div>
</section>

<section class="prose-section" id="signup">
  <div class="section-container prose">
    <h2 class="section-title">{signup.data.title}</h2>
    <SignupContent />
  </div>
</section>

<section id="conference" class="conference-section">
  <div class="section-container">
    <h2 class="section-title centered">{conference.data.title}</h2>
    <p class="section-subtitle centered">{conference.data.subtitle}</p>
    <div class="conf-grid">
      <div class="conf-info">
        <ConferenceContent />
        <div class="conf-actions">
          <a href="https://indico.physi.uni-heidelberg.de/event/1277/" class="btn-primary" target="_blank" rel="noopener">More information</a>
        </div>
      </div>
      <img class="conf-photo" src="/eucaif.org/images/conference.jpg" alt="Audience at EuCAIFCon" loading="lazy" />
    </div>
  </div>
</section>

<Footer />
</Layout>
