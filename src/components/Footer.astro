---
const B = '/eucaif.org';
---
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={`${B}/images/eucaif-logo-icon.png`} alt="" width="48" height="48" />
      <div>
        <div class="footer-brand-name">EuCAIF</div>
        <div class="footer-brand-sub">European Coalition for AI<br />in Fundamental Physics</div>
      </div>
    </div>
    <div>
      <h4>Main Menu</h4>
      <ul class="footer-menu">
        <li><a href={`${B}/`}>Home</a></li>
        <li><a href={`${B}/people/`}>People</a></li>
        <li><a href={`${B}/publications/`}>Publications</a></li>
        <li><a href={`${B}/activities/`}>Activities</a></li>
        <li><a href={`${B}/material/`}>Material</a></li>
        <li><a href={`${B}/contact/`}>Contact</a></li>
        <li><a href={`${B}/join/`}>How to join</a></li>
      </ul>
    </div>
    <div class="footer-contact">
      <h4>Contact</h4>
      <p>For general questions about EuCAIF or the website, please contact <a href="mailto:info@eucaif.org">info@eucaif.org</a>.</p>
      <ul class="footer-links">
        <li><a href="mailto:eucaif-info@cern.ch">Mailing list: eucaif-info@cern.ch</a></li>
        <li><a href={`${B}/documents/EuCAIF-policy-v0.7.pdf`}>Policy document (PDF)</a></li>
      </ul>
      <img class="footer-jenaa" src={`${B}/images/jenaa.png`} alt="JENAA – Joint ECFA-NuPECC-APPEC Activities" loading="lazy" />
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© 2026 EuCAIF – European Coalition for AI in Fundamental Physics</span>
    </div>
  </div>
</footer>
