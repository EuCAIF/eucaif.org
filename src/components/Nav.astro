---
// Shared site navigation (white bar, long logo). The `transparent` prop is
// accepted for backwards compatibility but no longer changes the styling.
interface Props { transparent?: boolean }
const B = '/eucaif.org';
---
<nav id="navbar">
  <a href={`${B}/`} class="nav-logo">
    <img src={`${B}/images/eucaif-logo-long.png`} alt="EuCAIF – European Coalition for AI in Fundamental Physics" width="720" height="214" />
  </a>
  <div class="nav-links">
    <a href={`${B}/`}>Home</a>
    <a href={`${B}/activities/`}>Activities</a>
    <a href={`${B}/community/`}>People</a>
    <a href={`${B}/publications/`}>Papers</a>
    <a href={`${B}/material/`}>Material</a>
    <a href={`${B}/contact/`}>Contact</a>
    <a href={`${B}/join/`} class="nav-cta">How to join</a>
  </div>
  <button class="hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
