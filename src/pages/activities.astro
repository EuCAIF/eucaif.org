---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import yaml from 'js-yaml';
import wgRaw from '../data/working-groups.yml?raw';

type WG = { number: number; code: string; title: string; description: string; image?: string };
const groups = yaml.load(wgRaw) as WG[];
---

<Layout title="Activities – EuCAIF">
<Nav />

<section class="page-header">
  <div class="section-container">
    <h1 class="section-title">Activities</h1>
  </div>
</section>

<section class="page-body">
  <div class="section-container">
    <h2 class="section-title">Working group activities</h2>
    <p class="section-desc">EuCAIF activities are organised in dynamic open working groups.</p>
    <div class="wg-list">
      {groups.map(wg => (
        <article class="wg-card" id={wg.code.toLowerCase()}>
          <span class="wg-code">{wg.code}</span>
          <h3>{wg.title}</h3>
          <p class="wg-text">{wg.description}</p>
          {wg.image && <img class="wg-image" src={wg.image} alt="" loading="lazy" />}
        </article>
      ))}
    </div>
  </div>
</section>

<section class="prose-section" id="signup">
  <div class="section-container prose">
    <h2 class="section-title">Joining working group activities</h2>
    <p>How to sign up for working groups.</p>
    <p><strong>How to sign up to Email lists?</strong></p>
    <ul>
      <li>Go to <a href="http://cern.ch/egroups">http://cern.ch/egroups</a> &amp; log in (or create account if necessary)<br />Search for "EuCAIF" to see list of eucaif email lists</li>
      <li>Click "subscribe"!</li>
    </ul>
  </div>
</section>

<Footer />
</Layout>
